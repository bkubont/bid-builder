# Copy to .env.local for local development. On Hostinger, set these in hPanel
# (Node.js app > Environment variables). Never commit real values.

# --- Required ---------------------------------------------------------------

# MySQL / MariaDB connection, from hPanel > Databases > MySQL Databases.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Long random string that signs login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
BETTER_AUTH_SECRET=

# The site's public address, no trailing slash.
BETTER_AUTH_URL=https://estimate.fandg-llc.com

# --- First-time setup (needed until the Owner account exists) ----------------

# Email of the first Owner. Only this address can create the account.
OWNER_EMAIL=
# One-time code typed on the /setup page (12+ characters). Can be removed
# after setup.
SETUP_CODE=

# --- Optional ----------------------------------------------------------------

# Enables AI drafting. Without it, drafts use local pricebook matching.
OPENAI_API_KEY=
# OpenAI model for drafts.
OPENAI_MODEL=gpt-4o-mini
# Max AI drafts per company per day (protects the OpenAI bill).
AI_DAILY_LIMIT=50
# Send estimates/invoices by email from the app (https://resend.com).
# Leave empty to use Share / your own email app instead.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. estimates@fandg-llc.com
EMAIL_FROM=
# Max emails per company per 24 hours.
EMAIL_DAILY_LIMIT=100
# Database connections per server process.
DATABASE_POOL_SIZE=5
